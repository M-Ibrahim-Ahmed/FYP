# ScamShield Backend Environment Variables
# Copy this file to .env and fill in your secrets.
# DO NOT commit the .env file to version control.

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=ScamShield
MONGO_URI=mongodb+srv://scamshield:REPLACE_WITH_NEW_PASSWORD@scamshield.d60uuiz.mongodb.net/?appName=ScamShield

# Database Name
MONGO_DB=scamshield

# Selenium Remote URL (for Docker Safe Preview)
SELENIUM_REMOTE_URL=http://localhost:4444/wd/hub
